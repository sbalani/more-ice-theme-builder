{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "More Ice theme package manifest",
  "type": "object",
  "required": ["formatVersion", "id", "name", "version", "template"],
  "properties": {
    "formatVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 80 },
    "version": { "type": "integer", "minimum": 1 },
    "template": { "const": "new" },
    "replaceMissing": { "type": "boolean" },
    "colors": {
      "type": "object",
      "properties": {
        "primary": { "type": "string" },
        "background": { "type": "string" },
        "text": { "type": "string" },
        "buttonText": { "type": "string" }
      }
    },
    "labels": {
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 120 },
      "properties": {
        "title": { "type": "string", "maxLength": 120 },
        "subtitle": { "type": "string", "maxLength": 120 },
        "start": { "type": "string", "maxLength": 120 }
      }
    },
    "assets": {
      "type": "object",
      "properties": {
        "welcomeBackground": { "type": "string" },
        "logo": { "type": "string" },
        "productImage": { "type": "string" }
      }
    },
    "resources": {
      "description": "Complete New-theme resource overrides keyed by the original app's UI resource keys.",
      "type": "object",
      "additionalProperties": { "type": "string", "maxLength": 240 }
    },
    "layout": {
      "description": "Per-screen layer geometry in a 1080 by 1920 coordinate system.",
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "object",
          "required": ["type", "x", "y", "width", "height", "visible"],
          "properties": {
            "type": { "enum": ["text", "image", "promotion", "button", "header", "cards", "steps", "shape"] },
            "x": { "type": "number", "minimum": 0, "maximum": 1080 },
            "y": { "type": "number", "minimum": 0, "maximum": 1920 },
            "width": { "type": "number", "minimum": 20, "maximum": 1080 },
            "height": { "type": "number", "minimum": 20, "maximum": 1920 },
            "visible": { "type": "boolean" },
            "z": { "type": "number" },
            "text": { "type": "string", "maxLength": 240 },
            "fontSize": { "type": "number", "minimum": 8, "maximum": 240 },
            "color": { "type": "string" },
            "fill": { "type": "string" },
            "radius": { "type": "number", "minimum": 0, "maximum": 540 },
            "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
            "rotation": { "type": "number", "minimum": -180, "maximum": 180 },
            "media": { "type": "string", "maxLength": 80 }
          }
        }
      }
    }
  }
}
